  creditsText: {fileID: 1702543883}
  creditsContainer: {fileID: 534151013}
  blackBackground: {fileID: 0}
  fadeOverlayImage: {fileID: 0}
  typewriterSpeed: 0.05
  loreDisplayDuration: 5
  loreFadeOutDuration: 1.5
  creditsFadeInDuration: 1
  creditsScrollSpeed: 50
  creditsScrollDistance: 1000
  menuSceneName: SampleScene
  endFadeOutDuration: 2
  fadeOverlay: {fileID: 1329390405}
  loreContent: "E assim termina a nossa jornada...\r\n\r\nNas sombras do cemit\xE9rio
    antigo, os segredos foram finalmente revelados.\r\nAs almas perdidas encontraram
    o seu descanso eterno.\r\n\r\nMas lembra-te... algumas hist\xF3rias nunca terminam
    verdadeiramente.\r\nElas apenas esperam pelo pr\xF3ximo corajoso que ouse descobri-las.\r\n\r\nAt\xE9
    \xE0 pr\xF3xima vez, viajante..."
  creditsContent: "<size=48><b>CR\xC9DITOS</b></size>\r\n\r\n<size=36>Desenvolvimento</size>\r\n[O
    Teu Nome Aqui]\r\n\r\n<size=36>Game Design</size>\r\n[O Teu Nome Aqui]\r\n\r\n<size=36>Programa\xE7\xE3o</size>\r\n[O
    Teu Nome Aqui]\r\n\r\n<size=36>Arte & Design Visual</size>\r\n[O Teu Nome Aqui]\r\n\r\n<size=36>M\xFAsica
    & Som</size>\r\n[O Teu Nome Aqui]\r\n\r\n<size=36>Agradecimentos Especiais</size>\r\n\xC0
    minha fam\xEDlia e amigos\r\n\xC0 comunidade Unity\r\nA todos os jogadores\r\n\r\n\r\n<size=32><i>Obrigado
    por jogares!</i></size>\r\n\r\n\r\n<size=24>\xA9 2026 - Todos os direitos reservados</size>"
  musicSource: {fileID: 0}
  endingMusic: {fileID: 0}
